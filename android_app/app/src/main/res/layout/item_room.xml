<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Room Images -->
        <HorizontalScrollView
            android:id="@+id/hsvRoomImages"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:scrollbars="none"
            android:visibility="gone">
            <LinearLayout
                android:id="@+id/layoutRoomImages"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvRoomName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Phòng Standard"
                android:textColor="@android:color/black"
                android:textSize="18sp"
                android:textStyle="bold" />
                
            <TextView
                android:id="@+id/tvOccupancy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sức chứa: 2 người lớn"
                android:textSize="14sp"
                android:textColor="#555555"
                android:layout_marginTop="4dp" />

            <!-- Badges -->
            <LinearLayout
                android:id="@+id/layoutBadges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tvBreakfastBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="☕ Bao gồm ăn sáng"
                    android:textColor="#2E7D32"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:padding="4dp"
                    android:background="#E8F5E9"
                    android:layout_marginBottom="4dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvCancellationBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓ Miễn phí hủy"
                    android:textColor="#2E7D32"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:padding="4dp"
                    android:background="#E8F5E9"
                    android:layout_marginBottom="4dp"
                    android:visibility="gone" />
                    
                <TextView
                    android:id="@+id/tvRemainBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔥 Chỉ còn 1 phòng!"
                    android:textColor="#C62828"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:padding="4dp"
                    android:background="#FFEBEE"
                    android:layout_marginBottom="4dp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvRoomAmenities"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Wifi miễn phí, Điều hòa"
                android:textSize="13sp"
                android:textColor="#666666"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvOriginalPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="150 $"
                        android:textColor="#999999"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvRoomPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="120 $"
                        android:textColor="#E91E63"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <Button
                    android:id="@+id/btnBook"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#0073BB"
                    android:paddingHorizontal="24dp"
                    android:text="Đặt phòng"
                    android:textAllCaps="false"
                    android:textSize="14sp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>